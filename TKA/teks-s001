let state = {
 answered: Array(questions.length).fill(false),
 correct: Array(questions.length).fill(false)
};

function renderQuiz(){
  const quiz = document.getElementById("quiz");
  quiz.innerHTML = "";

  questions.forEach((item,index)=>{
    const card = document.createElement("section");
    card.className = "quiz-card";
    card.id = `q${index}`;

    const passage = item.passage ? `<div class="passage">${item.passage}</div>` : "";

    card.innerHTML = `
      <div class="question-head">
        <div class="number">${index+1}</div>
        <div>
          <div class="type-tag">${item.type}</div>
          <p class="question">${item.q}</p>
        </div>
      </div>
      ${passage}
      <div class="options" id="options-${index}">
        ${item.options.map((opt,optIndex)=>`
          <button class="option" onclick="answerQuestion(${index},${optIndex})">
            ${String.fromCharCode(65+optIndex)}. ${opt}
          </button>
        `).join("")}
      </div>
      <div id="feedback-${index}" class="feedback"></div>
      <div id="explanation-${index}" class="explanation">
        <strong>💡 Pembahasan:</strong><br>${item.explanation}
      </div>
    `;
    quiz.appendChild(card);
  });

  document.getElementById("totalQ").textContent = questions.length;
  updateStats();
}

function answerQuestion(qIndex, selected){
  if(state.answered[qIndex]) return;

  const item = questions[qIndex];
  const options = document.querySelectorAll(`#options-${qIndex} .option`);
  const feedback = document.getElementById(`feedback-${qIndex}`);
  const explanation = document.getElementById(`explanation-${qIndex}`);

  state.answered[qIndex] = true;
  state.correct[qIndex] = selected === item.answer;

  options.forEach((btn,i)=>{
    btn.disabled = true;
    if(i === item.answer) btn.classList.add("correct");
    if(i === selected && selected !== item.answer) btn.classList.add("wrong");
  });

  if(selected === item.answer){
    feedback.className = "feedback correct";
    feedback.innerHTML = "✅ BENAR! Jawabanmu tepat.";
  }else{
    feedback.className = "feedback wrong";
    feedback.innerHTML = `❌ SALAH. Jawaban yang benar adalah <strong>${String.fromCharCode(65+item.answer)}. ${item.options[item.answer]}</strong>.`;
  }

  explanation.style.display = "block";
  updateStats();

  setTimeout(()=>{
    feedback.scrollIntoView({behavior:"smooth",block:"center"});
  },100);
}

function updateStats(){
  const answered = state.answered.filter(Boolean).length;
  const correct = state.correct.filter(Boolean).length;
  const score = answered ? Math.round(correct / questions.length * 100) : 0;

  document.getElementById("answered").textContent = answered;
  document.getElementById("score").textContent = score;
  document.getElementById("progressFill").style.width = `${answered/questions.length*100}%`;

  const result = document.getElementById("result");
  if(answered === questions.length){
    result.style.display = "block";
    document.getElementById("resultText").innerHTML =
      `Kamu menjawab <strong>${correct}</strong> dari <strong>${questions.length}</strong> soal dengan benar. Skor latihan: <span class="badge">${score}/100</span>`;
    document.getElementById("resultAdvice").innerHTML = `
      <p><strong>Interpretasi latihan:</strong></p>
      <p>${getAdvice(score)}</p>
    `;
  }
}

function getAdvice(score){
  if(score >= 90) return "🌟 Sangat baik! Pemahamanmu tentang karakteristik teks dan strategi reading sudah kuat. Pertahankan dengan latihan soal inference dan paraphrase.";
  if(score >= 75) return "👍 Bagus! Dasarmu sudah cukup kuat. Perbanyak latihan main idea, vocabulary dari konteks, dan soal yang membutuhkan inferensi.";
  if(score >= 60) return "📚 Cukup baik. Ulangi 5 jenis teks, struktur, dan strategi scanning–skimming. Setelah itu kerjakan kuis lagi.";
  return "🌱 Jangan berkecil hati. Pelajari kembali tabel 5 jenis teks, tujuan, struktur, dan teknik mencari kata kunci. Kerjakan ulang sampai polanya terasa familiar.";
}

function scrollToFirstUnanswered(){
  const index = state.answered.findIndex(v=>!v);
  if(index === -1){
    document.getElementById("result").scrollIntoView({behavior:"smooth"});
  }else{
    document.getElementById(`q${index}`).scrollIntoView({behavior:"smooth",block:"start"});
  }
}

function resetQuiz(){
  state = {
    answered: Array(questions.length).fill(false),
    correct: Array(questions.length).fill(false)
  };
  renderQuiz();
  window.scrollTo({top:0,behavior:"smooth"});
}

renderQuiz();
</script>
